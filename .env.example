# Slack -> your app at api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-...      # OAuth & Permissions -> Bot User OAuth Token
SLACK_APP_TOKEN=xapp-...      # Basic Information -> App-Level Tokens (connections:write)

# Channel IDs, not names, and not a DM. Open the channel -> click its name ->
# the ID is at the bottom of the About tab. They start with C.
RAW_CHANNEL_ID=C0...          # where forwarded email lands
HITS_CHANNEL_ID=C0...         # where interview emails get posted

# OpenRouter -> openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...
# Check the exact slug at openrouter.ai/models before changing this.
OPENROUTER_MODEL=deepseek/deepseek-chat

# How many days to re-check on startup (catch-up after downtime)
CATCHUP_DAYS=7

# Drop "thank you for applying" mail with rules instead of asking the model.
# Cheaper, but this category caused both production misses. Default: false.
DROP_CONFIRMATIONS=false

# Rate limiting. Requests are serialised and spaced this many seconds apart;
# on a 429 the spacing grows automatically and eases back after success.
# Raise this if you keep seeing "rate limited" in the log.
CLASSIFY_MIN_INTERVAL=2.0
CLASSIFY_RETRIES=6

# Re-scan #inbox-raw this often (minutes) to recover events Slack failed to
# deliver. 0 disables the periodic sweep (startup catch-up still runs).
CATCHUP_EVERY_MIN=15
